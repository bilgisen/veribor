# Cache — Upstash REST (tercih edilen) veya REDIS_URL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=rediss://default:TOKEN@host.upstash.io:6379

# Senkronizasyon
SYNC_INTERVAL_SECONDS=60
STALE_AFTER_SECONDS=120
ENRICH_INTERVAL_SECONDS=300
ISY_CHUNK_SIZE=20
ENABLE_ISY_ENRICHMENT=true

# CORS
CORS_ORIGINS=https://jetborsa.com,http://localhost:3000,http://127.0.0.1:3000
